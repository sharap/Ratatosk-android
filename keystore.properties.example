# Образец. Скопируйте в `keystore.properties` рядом с этим файлом
# и впишите своё — настоящий файл в репозиторий не попадает.
#
#     cp keystore.properties.example keystore.properties
#
# Пока `keystore.properties` нет, release подписывается отладочным
# ключом, и раздавать такую сборку нельзя.

# Путь к хранилищу. Относительный считается от корня проекта.
storeFile=app/keystore/release.jks

# Пароль хранилища.
storePassword=

# Псевдоним ключа внутри хранилища и его пароль.
keyAlias=release
keyPassword=
